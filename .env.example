# Shared configuration. Keep the actual .env local, chmod 600; never NEXT_PUBLIC_ secrets.
APP_ENV=local
MOCK_LLM=1
DEEPSEEK_API_KEY=
# Select the exact DeepSeek V4.1 Flash ID from DeepSeek's authenticated model catalog.
MODEL=deepseek-flash
WORKER_CONCURRENCY=4
# For a private hosted pilot: APP_ENV=production; long password; HTTPS is required.
OPERATOR_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
# Used only by the server-side Next.js API proxy in a hosted deployment.
BACKEND_OPERATOR_USER=operator
BACKEND_OPERATOR_PASSWORD=
# No external tracing is enabled by default.
LANGSMITH_TRACING=false
